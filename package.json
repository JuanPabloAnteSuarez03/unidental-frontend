{
    "name": "unidental-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --coverage --watchAll=false",
        "test:unit": "jest --testPathPattern=__tests__",
        "test:integration": "jest --testPathPattern=integration",
        "test:e2e": "playwright test",
        "test:e2e:dev": "playwright test --project=chromium",
        "test:e2e:ui": "playwright test --ui",
        "test:accessibility": "jest --testPathPattern=accessibility",
        "test:visual": "playwright test --config=playwright.visual.config.js",
        "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
        "test:critical": "npx playwright test ventas-flow.spec.js compras-flow.spec.js devoluciones-flow.spec.js --project=chromium",
        "test:api": "node scripts/api-testing.js",
        "test:manual": "node scripts/manual-testing-guide.js",
        "test:integration:simple": "jest --testPathPattern=integration --runInBand",
        "test:quick": "npm run test:unit && npm run test:api",
        "test:practical": "npm run test:unit && npm run test:integration:simple && npm run test:api",
        "test:security": "npm audit",
        "test:monitor": "node scripts/test-monitor.js"
    },
    "dependencies": {
        "axios": "^1.9.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-icons": "^5.5.0",
        "react-router-dom": "^7.6.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.24.7",
        "@babel/preset-react": "^7.24.7",
        "@eslint/js": "^9.22.0",
        "@testing-library/jest-dom": "^6.4.6",
        "@testing-library/react": "^16.0.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/jest": "^29.5.12",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.22.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "postcss": "^8.5.3",
        "tailwindcss": "^3.4.17",
        "vite": "^6.3.1",
        "@playwright/test": "^1.48.0",
        "@axe-core/playwright": "^4.10.0",
        "jest-axe": "^8.0.0",
        "jest-extended": "^4.0.2",
        "msw": "^2.4.0",
        "react-test-renderer": "^19.0.0",
        "cross-env": "^7.0.3",
        "wait-for-expect": "^3.0.2"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "testMatch": [
            "<rootDir>/src/**/__tests__/**/*.{js,jsx}",
            "<rootDir>/src/**/*.{test,spec}.{js,jsx}",
            "<rootDir>/tests/**/*.test.{js,jsx}"
        ],
        "testPathIgnorePatterns": [
            "<rootDir>/tests/e2e/",
            "<rootDir>/tests/accessibility/",
            "<rootDir>/tests/visual/"
        ],
        "moduleNameMapper": {
            "\\.(css|less|scss|sass)$": "identity-obj-proxy"
        },
        "transform": {
            "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
        },
        "setupFilesAfterEnv": [
            "<rootDir>/src/setupTests.js"
        ],
        "setupFiles": [
            "<rootDir>/jest.setup.js"
        ],
        "collectCoverageFrom": [
            "src/**/*.{js,jsx}",
            "!src/main.jsx",
            "!src/index.css",
            "!src/**/*.test.{js,jsx}",
            "!src/__tests__/**",
            "!src/__mocks__/**"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 80,
                "functions": 80,
                "lines": 80,
                "statements": 80
            }
        },
        "testTimeout": 10000,
        "maxWorkers": "50%"
    }
}
